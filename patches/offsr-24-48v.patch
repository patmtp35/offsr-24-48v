diff --git a/components/offsr/offsr.h b/components/offsr/offsr.h
index 026af77..61b9822 100644
--- a/components/offsr/offsr.h
+++ b/components/offsr/offsr.h
@@ -122,6 +122,20 @@ SUB_SELECT(coeff_multiplier)
   void set_coeff_multiplier(float value) {this->current_coeff_multiplier_ = value;}
   float get_coeff_multiplier(void){return this->current_coeff_multiplier_;}
 
+  // Flag battery_nominal (24 ou 48 V) : fixe les seuils PAR DEFAUT starting/charged/discharged.
+  // 48 V = valeurs d'origine (53.0 / 55.8 / 55.6). Une valeur deja sauvee en flash par les
+  // entites number reste prioritaire (a re-saisir une fois si on change le flag).
+  // 24 V gel : starting 27.0 (batterie pleine au repos ~25.8 V), charged 28.0, discharged 27.6.
+  void set_battery_nominal(int nominal) {
+#ifdef USE_NUMBER
+    if (nominal == 24) {
+      this->current_starting_battery_voltage_ = 27.0f;
+      this->current_charged_battery_voltage_ = 28.0f;
+      this->current_discharged_battery_voltage_ = 27.6f;
+    }
+#endif
+  }
+
 #ifdef USE_BINARY_SENSOR
   bool get_thermostat_cut(void){return this->current_thermostat_cut_;}
 #endif
